<Window x:Class="PromptDraft.ServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Prompt Draft Server Manager" Height="820" Width="1220"
        MinHeight="700" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock x:Name="TitleText" Text="Prompt Draft Server Manager" FontSize="28" FontWeight="SemiBold" />
        <TextBlock x:Name="SubtitleText" Text="Local operations console" Opacity="0.7" Margin="0,4,0,0" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="LanguageButton"
                Width="40" Height="40" Margin="0,0,8,0" Padding="8"
                Style="{StaticResource MaterialDesignIconButton}"
                Click="LanguageButton_Click">
          <materialDesign:PackIcon x:Name="LanguageToggleIcon" Width="22" Height="22" />
        </Button>
        <Button x:Name="ThemeButton"
                Width="40" Height="40" Padding="8"
                Style="{StaticResource MaterialDesignIconButton}"
                Click="ThemeButton_Click">
          <materialDesign:PackIcon x:Name="ThemeToggleIcon" Width="22" Height="22" />
        </Button>
      </StackPanel>
    </DockPanel>

    <materialDesign:Card Grid.Row="2" Padding="14">
      <DockPanel>
        <StackPanel Orientation="Horizontal">
          <materialDesign:PackIcon x:Name="ManagerStateVisualIcon" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock x:Name="ManagerStateText" Text="Initializing" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="LastCheckedText" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.65" Text="Waiting for first check..." />
      </DockPanel>
    </materialDesign:Card>

    <UniformGrid Grid.Row="4" Columns="5">
      <materialDesign:Card Margin="0,0,10,0" Padding="16">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <materialDesign:PackIcon x:Name="DockerVisualIcon" Width="24" Height="24" Margin="0,1,12,0" />
          <StackPanel Grid.Column="1"><TextBlock x:Name="DockerLabel" Text="Docker" FontWeight="SemiBold"/><TextBlock x:Name="DockerState" Text="Unknown" Margin="0,8,0,0"/></StackPanel>
        </Grid>
      </materialDesign:Card>
      <materialDesign:Card Margin="0,0,10,0" Padding="16">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <materialDesign:PackIcon x:Name="StackVisualIcon" Width="24" Height="24" Margin="0,1,12,0" />
          <StackPanel Grid.Column="1"><TextBlock x:Name="StackLabel" Text="Stack" FontWeight="SemiBold"/><TextBlock x:Name="StackState" Text="Unknown" Margin="0,8,0,0"/></StackPanel>
        </Grid>
      </materialDesign:Card>
      <materialDesign:Card Margin="0,0,10,0" Padding="16">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <materialDesign:PackIcon x:Name="TunnelVisualIcon" Width="24" Height="24" Margin="0,1,12,0" />
          <StackPanel Grid.Column="1"><TextBlock x:Name="TunnelLabel" Text="Tunnel" FontWeight="SemiBold"/><TextBlock x:Name="TunnelState" Text="Unknown" Margin="0,8,0,0"/></StackPanel>
        </Grid>
      </materialDesign:Card>
      <materialDesign:Card Margin="0,0,10,0" Padding="16">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <materialDesign:PackIcon x:Name="StagingVisualIcon" Width="24" Height="24" Margin="0,1,12,0" />
          <StackPanel Grid.Column="1"><TextBlock x:Name="StagingLabel" Text="Staging" FontWeight="SemiBold"/><TextBlock x:Name="StagingState" Text="Unknown" Margin="0,8,0,0"/><TextBlock x:Name="StagingDetail" Text="Frontend: ? / API: ?" Opacity="0.6" Margin="0,4,0,0" FontSize="11"/></StackPanel>
        </Grid>
      </materialDesign:Card>
      <materialDesign:Card Padding="16">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <materialDesign:PackIcon x:Name="ProductionVisualIcon" Width="24" Height="24" Margin="0,1,12,0" />
          <StackPanel Grid.Column="1"><TextBlock x:Name="ProductionLabel" Text="Production" FontWeight="SemiBold"/><TextBlock x:Name="ProductionState" Text="Unknown" Margin="0,8,0,0"/><TextBlock x:Name="ProductionDetail" Text="Frontend: ? / API: ?" Opacity="0.6" Margin="0,4,0,0" FontSize="11"/></StackPanel>
        </Grid>
      </materialDesign:Card>
    </UniformGrid>

    <Grid Grid.Row="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <materialDesign:Card Grid.Column="0" Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
          <ScrollViewer.Resources>
            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ManagerMinimalScrollBar}" />
          </ScrollViewer.Resources>
          <StackPanel>
            <TextBlock x:Name="OwnerAccessTitle" Text="Owner access" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="OwnerAccessDescription" Text="Unlock before running management actions." TextWrapping="Wrap" Opacity="0.7" Margin="0,8,0,8" />
            <TextBlock x:Name="FirstRunHint" Text="First run: create an owner password and confirm it." TextWrapping="Wrap" Opacity="0.65" Margin="0,0,0,12" Visibility="Collapsed" />
            <PasswordBox x:Name="OwnerPassword" materialDesign:HintAssist.Hint="Owner password" Margin="0,0,0,12" />
            <PasswordBox x:Name="ConfirmOwnerPassword" materialDesign:HintAssist.Hint="Confirm owner password" Margin="0,0,0,12" Visibility="Collapsed" />
            <Button x:Name="UnlockButton" Content="Unlock" Style="{StaticResource MaterialDesignRaisedButton}" Click="UnlockButton_Click" />
            <Button x:Name="LockButton" Content="Lock" Margin="0,8,0,0" Visibility="Collapsed" Click="LockButton_Click" />
            <TextBlock x:Name="AuthStateText" Text="Locked" Margin="0,12,0,0" Opacity="0.7" />

            <Separator Margin="0,20,0,16" />
            <TextBlock x:Name="TargetLabel" Text="Target" FontWeight="SemiBold" />
            <TextBlock x:Name="TargetPathText" TextWrapping="Wrap" Opacity="0.65" Margin="0,4,0,8" FontSize="11" />
            <Button x:Name="BrowseRepoButton" Content="Choose repository folder" Margin="0,0,0,6" IsEnabled="False" Click="BrowseRepoButton_Click" />
            <TextBlock x:Name="RepoPathNotice" TextWrapping="Wrap" Opacity="0.65" Margin="0,0,0,16" FontSize="11" />

            <TextBlock x:Name="StackOperationsLabel" Text="Server stack" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Button x:Name="EnsureButton" Content="Ensure Server Running" Margin="0,0,0,8" IsEnabled="False" Click="EnsureButton_Click" />
            <Button x:Name="RestartButton" Content="Restart Server (no build)" Margin="0,0,0,8" IsEnabled="False" Click="RestartButton_Click" />
            <Button x:Name="StopButton" Content="Stop Server" Margin="0,0,0,8" IsEnabled="False" Click="StopButton_Click" />
            <Button x:Name="RefreshButton" Content="Refresh Status" Margin="0,0,0,8" IsEnabled="False" Click="RefreshButton_Click" />
            <Button x:Name="StackLogsButton" Content="Stack Logs" IsEnabled="False" Click="StackLogsButton_Click" />

            <Separator Margin="0,18,0,10" />
            <Expander x:Name="FrontendExpander" Header="Frontend" IsExpanded="False">
              <StackPanel Margin="0,8,0,4">
                <Button x:Name="FrontendBuildButton" Content="Build / Start" Margin="0,0,0,8" IsEnabled="False" Click="FrontendBuildButton_Click" />
                <Button x:Name="FrontendRestartButton" Content="Rebuild &amp; Restart" Margin="0,0,0,8" IsEnabled="False" Click="FrontendRestartButton_Click" />
                <Button x:Name="FrontendStopButton" Content="Stop" Margin="0,0,0,8" IsEnabled="False" Click="FrontendStopButton_Click" />
                <Button x:Name="FrontendStatusButton" Content="Status" Margin="0,0,0,8" IsEnabled="False" Click="FrontendStatusButton_Click" />
                <Button x:Name="FrontendLogsButton" Content="Logs" IsEnabled="False" Click="FrontendLogsButton_Click" />
              </StackPanel>
            </Expander>

            <Expander x:Name="ApiExpander" Header="API" IsExpanded="False" Margin="0,8,0,0">
              <StackPanel Margin="0,8,0,4">
                <Button x:Name="ApiBuildButton" Content="Build / Start" Margin="0,0,0,8" IsEnabled="False" Click="ApiBuildButton_Click" />
                <Button x:Name="ApiRestartButton" Content="Rebuild &amp; Restart" Margin="0,0,0,8" IsEnabled="False" Click="ApiRestartButton_Click" />
                <Button x:Name="ApiStopButton" Content="Stop" Margin="0,0,0,8" IsEnabled="False" Click="ApiStopButton_Click" />
                <Button x:Name="ApiStatusButton" Content="Status" Margin="0,0,0,8" IsEnabled="False" Click="ApiStatusButton_Click" />
                <Button x:Name="ApiLogsButton" Content="Logs" IsEnabled="False" Click="ApiLogsButton_Click" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </materialDesign:Card>

      <materialDesign:Card Grid.Column="2" Padding="20">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="ActivityTitle" Text="Activity" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="CopyActivityButton" Width="36" Height="36" Padding="7" Margin="0,0,4,0" Style="{StaticResource MaterialDesignIconButton}" Click="CopyActivityButton_Click">
                <materialDesign:PackIcon x:Name="CopyActivityIcon" Width="19" Height="19" />
              </Button>
              <Button x:Name="ClearActivityButton" Width="36" Height="36" Padding="7" Style="{StaticResource MaterialDesignIconButton}" Click="ClearActivityButton_Click">
                <materialDesign:PackIcon x:Name="ClearActivityIcon" Width="19" Height="19" />
              </Button>
            </StackPanel>
          </DockPanel>
          <TextBlock x:Name="ActivityLockedText" Text="Unlock owner access to view activity logs." HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65" />
          <TextBox x:Name="LogBox" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" BorderThickness="0" Padding="4,2,10,2">
            <TextBox.Resources>
              <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ManagerMinimalScrollBar}" />
            </TextBox.Resources>
          </TextBox>
        </DockPanel>
      </materialDesign:Card>
    </Grid>
  </Grid>
</Window>
