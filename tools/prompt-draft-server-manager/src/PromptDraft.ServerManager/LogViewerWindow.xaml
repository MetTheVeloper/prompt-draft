<Window x:Class="PromptDraft.ServerManager.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logs" Height="620" Width="980"
        MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Closing="Window_Closing">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock x:Name="HeaderText" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusText" Text="Connecting..." Opacity="0.65" Margin="0,4,0,0" />
      </StackPanel>
      <Button x:Name="StopButton" DockPanel.Dock="Right" Content="Stop stream" Padding="16,8" Click="StopButton_Click" />
    </DockPanel>

    <TextBox Grid.Row="2" x:Name="OutputBox"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="NoWrap"
             FontFamily="Consolas"
             FontSize="12"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto" />
  </Grid>
</Window>
