# Local-only runtime configuration template.
# Copy this file to .env and fill secrets there. .env is gitignored.
# Never commit real access keys or secret keys.

# Prompt Archive media storage (ArvanCloud S3-compatible Object Storage)
ARCHIVE_S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
ARCHIVE_S3_REGION=ir-thr-at1
ARCHIVE_S3_BUCKET=prompt-draft-archive-media
ARCHIVE_S3_PUBLIC_BASE_URL=https://prompt-draft-archive-media.s3.ir-thr-at1.arvanstorage.ir
ARCHIVE_S3_FORCE_PATH_STYLE=true
ARCHIVE_S3_OBJECT_ACL=public-read
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=

# Capability-spike behavior. Enable true when verifying anonymous media reads.
ARCHIVE_S3_SMOKE_PUBLIC_READ=false
