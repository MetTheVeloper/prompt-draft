# Local/production runtime configuration template.
# Copy this file to .env and fill secrets there. .env is gitignored.
# Never commit real access keys, secret keys, tunnel tokens, or other credentials.

# Browser-visible API origin.
# Local Docker/preview default: http://localhost:4000
# Staging Cloudflare example: https://api.grassic.ir
# Production Cloudflare target: https://api.prompt-draft.ir
NUXT_PUBLIC_API_BASE=http://localhost:4000

# Public frontend origin used to build canonical/Open Graph/sitemap URLs.
# Docker Compose supplies http://localhost:3000 as its local fallback.
# Staging Cloudflare example: https://grassic.ir
# Production Cloudflare target: https://prompt-draft.ir
NUXT_PUBLIC_SITE_URL=

# Global staging crawl guard. Keep false for local/production.
# Set true on temporary public staging domains such as grassic.ir.
# This emits both robots meta and X-Robots-Tag noindex headers.
NUXT_PUBLIC_NOINDEX=false

# Browser origins allowed to call the API directly.
# Local Compose has a localhost fallback when this is empty.
# Staging example:
# CORS_ORIGINS=https://grassic.ir,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3030,http://127.0.0.1:3030
# Production example:
# CORS_ORIGINS=https://prompt-draft.ir,https://www.prompt-draft.ir
CORS_ORIGINS=

# Host-port exposure. Defaults in compose.yaml are loopback-only so the
# Cloudflare Tunnel can be the public ingress while localhost smoke tests keep working.
FRONTEND_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1

# Remote-managed Cloudflare Tunnel token.
# Required only for compose.cloudflare.yaml / stack:cloudflare commands.
# Create the tunnel in Cloudflare Zero Trust and keep the token only in the
# production .env / secret store. Never commit the real token.
CLOUDFLARE_TUNNEL_TOKEN=

# NOTE: NUXT_API_BASE_INTERNAL is server-only and supplied by compose.yaml as
# http://api:4000. Do not normally add it to the host .env, because host-side
# pnpm build/preview cannot resolve the Docker service hostname "api".

# Blog canonical Git publication (server-only; never NUXT_PUBLIC_*).
# Use a fine-grained GitHub token scoped only to this repository with Contents
# read/write permission. Management reads/writes Git only when all three values
# are configured; public Blog requests continue to use bundled deployed content.
BLOG_GITHUB_TOKEN=
BLOG_GITHUB_REPOSITORY=MetTheVeloper/prompt-draft
BLOG_GITHUB_BRANCH=feature/growth-foundation

# Prompt Archive / shared managed media storage (ArvanCloud S3-compatible Object Storage)
ARCHIVE_S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
ARCHIVE_S3_REGION=ir-thr-at1
ARCHIVE_S3_BUCKET=prompt-draft-archive-media
ARCHIVE_S3_PUBLIC_BASE_URL=https://prompt-draft-archive-media.s3.ir-thr-at1.arvanstorage.ir
ARCHIVE_S3_FORCE_PATH_STYLE=true
ARCHIVE_S3_OBJECT_ACL=public-read
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=

# Capability-spike behavior. Enable true when verifying anonymous media reads.
ARCHIVE_S3_SMOKE_PUBLIC_READ=false
